# Copy this file to .env in the repository root and fill it in. .env is gitignored: never commit it.
#
# Only the language-model key is read from this file. Without it the system still builds and runs; certified
# metrics, single-case facts, refusals and the whole data pipeline work, and only the model-backed answers
# (policy, call summaries, generated queries, the router fallback) say they need the model.
OPENROUTER_API_KEY=sk-or-v1-replace-with-your-key
