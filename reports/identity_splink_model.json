            "sql_dialect": "duckdb"
        },
        {
            "blocking_rule": "l.first_name = r.last_name AND l.last_name = r.first_name AND (l.source_system = 'crm' OR r.source_system = 'crm') AND (l.needs_match OR r.needs_match) AND NOT (l.national_id_hash IS NOT NULL AND r.national_id_hash IS NOT NULL)",
            "sql_dialect": "duckdb"
